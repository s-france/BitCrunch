//vfx
function circle_lights(offs)
	//move pos
	
	local lpos = flr(((tick%spawnrate)/spawnrate) * 60)
	lpos = (lpos-offs)%60
	local lposx = 0
	local lposy = 0
	
	if lpos < 15 then
		lposx = lpos
		lposy = 0
	elseif lpos < 30 then
		lposx = 15
		lposy = lpos-15
	elseif lpos < 45 then
		lposx = 15-(lpos-30)
		lposy = 15
	elseif lpos <= 60 then
		lposx = 0
		lposy = 15-(lpos-45)
	end
	
	local cpos = flr(((tick%spawnrate)/spawnrate) * 120)

	
	//light up numbers
	pal(1,colors[1])
	if lposy == 15 or lposx == 0 then
		if cpos%2 == 0 then
			spr(39,(lposx*8)+4,(lposy*8)+4,.5,.5)
		else
			spr(23,lposx*8,lposy*8,.5,.5)
		end
	else
		if cpos%2 == 0 then
			spr(23,lposx*8,lposy*8,.5,.5)
		else
			spr(39,(lposx*8)+4,(lposy*8)+4,.5,.5)
		end
	end
	pal()
end
