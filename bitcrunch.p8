//draw functions
function draw_box()
	box_posx = 4
	box_posy = 4
	
	local tlx = 25 + box_posx
	local tly = 115 + box_posy
	
	local brx = 95 + box_posx
	local bry = 25 + box_posy
	
	local tlxoff = 10
	local tlyoff = -8
	
	local brxoff = -10
	local bryoff = -8
	
	box_data = {tlx,
													tly,
													brx,
													bry,
													tlxoff,
													tlyoff,
													brxoff,
													bryoff}
	
	//draw back box
	rect(tlx+tlxoff, tly+tlyoff,  brx+brxoff, bry+bryoff, 5)
	
	//draw connecting lines
	line(tlx, tly, tlx+tlxoff, tly+tlyoff, 5)
	line(brx, bry, brx+brxoff, bry+bryoff, 5)
	line(tlx,bry, tlx+tlxoff, bry+bryoff, 5)
	line(brx, tly, brx+brxoff, tly+tlyoff, 5)
	
	//draw front box
	rect(tlx, tly, brx, bry, 6)

end

//init all gameplay stuff
function start_game()
	started = true
	game_over = false
	game_grid = init_grid(7,12)
	
	clear_rows = {}
	
	danger = false
	
	rotation = 1
	
	
	combo = 0
	combo_timer = 0
	combo_time = 0
	
	display_score = 0
	score = 0
	highest = 0 //highest bit y val
	lowest = 0
	

	
	difficultyrate = 650

	spawnrate = 250
	
	
	fallrate=3
	blinkrate = 35
	
	clearrate = 13
	clear_timer = 0
	
	tick = 0
	
	
	//init frames
	frame = create_frame(rnd(all_shapes),rnd({1,2,3}), {rnd({0,1}),rnd({0,1}),rnd({0,1}),rnd({0,1})})
	next_frame = create_frame(rnd(all_shapes),rnd({1,2,3}), {rnd({0,1}),rnd({0,1}),rnd({0,1}),rnd({0,1})})
	
	spawn_bits(0)
	spawn_bits(1)
	spawn_bits(2)
	
end

function update_game()
	move_frame()
	
	//track highest bit xpos
	count_highest()
	
	if highest > 8 then
		danger = true
	else 
		danger = false
	end
	
	//update clear_timer
	clear_timer+=1
	//update combo counter
	combo_timer += 1
	if combo_timer >= combo_time and combo > 1 and tick%4==0 then
		combo -= 1
	end
	if combo <1 then
		combo = 1
	end
	

	if(tick%fallrate == 0) then
		update_grid(game_grid)
	end
	
	
	if(tick%spawnrate == 0) then
		spawn_bits(0)
		//sfx(7)
	elseif lowest < 2 then
		spawn_bits(0)
	else
		for x=0, game_grid.width do
			if col_isempty(x) then
				spawn_bits(0)
			end
		end
	end
	
	if(tick%(fallrate*2) == 1) then
		clear_check(game_grid)
	end
	
	if(tick%difficultyrate == 0) then
		increase_difficulty()
	end
	
	if tick%5 == 0 then
		colors = pick_clear_colors()
	end

end


function draw_game()
	//map background
	local rnbw = colors[1]
	if clear_timer < clearrate then
		pal(1,rnbw)
		map(80,0, 0,0, 16,16)
		pal()
	elseif danger and tick%50>35 then
		pal(1,136)
		map(80,0, 0,0, 16,16)
		pal()
	else
		map(80,0, 0,0, 16,16)
	end
	
	//circle_lights(0)
	for l=0, (combo-1)*2 do
		circle_lights(l)
	end
	
	draw_box()
	draw_grid(game_grid)
	
	if tick%blinkrate > .5 * blinkrate then
		draw_frame_full()
	else
		draw_frame_wire()
	end
	
	draw_score()
	draw_operator()
	draw_frame_preview()
end


function end_game()
	
	if score > high_score then
		high_score = score
		dset(1,high_score)
	end
	
	game_over = true
	started = false
	//score = 0
	
	
end

function increase_difficulty()
	tick = 0
	spawnrate -= 10
	difficultyrate +=10
end
