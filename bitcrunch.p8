__lua__
function _init()
	cartdata("bitcruncher")
	high_score = dget(1)
	
	
	//reset high score
	//dset(1,0)
	
	init_title()
	

	
end

function init_title()
	cls()
	started = false
	game_over = false
	tick = 0
	colors = pick_clear_colors()
	score = 0
	spawnrate = 0
	display_score = 0
	//play music
	music(0)
end


function _update()

	update_input()
	a_button()
	b_button()
	
	
	if started and not game_over then
		update_game()
	end
	
	
	
	if(tick<30000) then
		tick = tick+1
	else
		tick = 1
	end

end


function _draw()
	cls()
	
	if started then
		draw_game()
	elseif game_over then
		draw_end_screen()
	else
		draw_title_screen()
