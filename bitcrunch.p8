function update_input()
	up = false
	down= false
	left= false
	right= false
	a= false
	b = false
	
	
	
	//left
	if btn(0) then
		if not lpress then
			left = true
			ltimer = 0
		else
			left = false
		end
	 
	 ltimer += 1
		lpress = true
		
	else
		lpress = false
		left = false
		ltimer = 0
	end
	
	//right
	if(btn(1)) then
		if not rpress then
			right = true
			rtimer = 0
		else
			right = false
		end
		 
		rtimer += 1
		rpress = true
	else
		rpress = false
		right = false
		rtimer = 0
	end
	
	//up
	if(btn(2)) then
		if not upress then
			up = true
			uptimer = 0
		else
			up = false
		end
		
		uptimer += 1
		upress = true
	else
		upress = false
		up = false
		uptimer = 0
	end
	
	//down
	if(btn(3)) then
		if not dpress then
			down = true
			downtimer = 0
		else
			down = false
		end
	
		downtimer += 1
		dpress = true
	else
		dpress = false
		down = false
